# ====================
# PRODUCTION ENVIRONMENT VARIABLES - CFC Backend
# ====================
# ⚠️ NEVER commit actual .env files to version control
# ⚠️ Use secret management service (AWS Secrets Manager, Azure Key Vault, etc.)
# ====================

# Application
NODE_ENV=production
PORT=4000

# Logging
LOG_LEVEL=info

# ====================
# DATABASE
# ====================
# Use managed database service (AWS RDS, Azure Database, etc.)
# Enable SSL/TLS connection
DATABASE_URL="postgresql://username:password@host:5432/cfc?sslmode=require"

# ====================
# REDIS
# ====================
# Use managed Redis service (AWS ElastiCache, Azure Cache, etc.)
REDIS_URL="redis://username:password@host:6379"

# ====================
# SECURITY SECRETS
# ====================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-512-bit-jwt-secret-here-64-hex-characters-minimum"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET="your-256-bit-csrf-secret-here-32-hex-characters-minimum"

# ====================
# CORS
# ====================
# ⚠️ CRITICAL: Set specific domains only - NO WILDCARDS
# Comma-separated list of allowed origins
CORS_ORIGIN=https://cocksfight.club,https://www.cocksfight.club

# ====================
# BLOCKCHAIN CONFIGURATION
# ====================
# BSC RPC Endpoint - Use reliable provider (Ankr, Infura, QuickNode)
BNB_RPC_ENDPOINT=https://bsc-dataseed1.bnbchain.org
BSC_RPC_URL=https://bsc-dataseed1.bnbchain.org

# Treasury wallet private key - STORE IN SECRET MANAGER
# ⚠️ CRITICAL: Never expose this key
TREASURY_PRIVATE_KEY="store-in-aws-secrets-manager"
TREASURY_ADDRESS="your-treasury-wallet-address"

# House wallet private key (if different from treasury)
HOUSE_WALLET_PRIVATE_KEY="store-in-aws-secrets-manager"

# Smart Contract Addresses
CFC_TOKEN_ADDRESS="your-cfc-token-contract-address"
ESCROW_CONTRACT_ADDRESS="your-escrow-contract-address"

# ====================
# ADMIN CONFIGURATION
# ====================
# Admin wallet address(es) - comma-separated
ADMIN_WALLET_ADDRESS="0xYourAdminWalletAddress"

# ====================
# MONITORING & LOGGING
# ====================
# Sentry for error tracking (optional)
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project"

# Datadog (optional)
DD_API_KEY="your-datadog-api-key"
DD_SITE="datadoghq.com"

# ====================
# PRODUCTION CHECKLIST
# ====================
# Before deploying, ensure:
# ✅ All secrets are stored in secret manager (AWS Secrets Manager, Azure Key Vault)
# ✅ CORS_ORIGIN is set to specific domains (no wildcards)
# ✅ Database uses SSL/TLS connections
# ✅ Treasury private keys are rotated and secured
# ✅ Monitoring and alerting is configured
# ✅ Rate limiting is properly tuned
# ✅ WAF (Web Application Firewall) is enabled
# ✅ DDoS protection is active
# ✅ Backup and recovery procedures are tested
# ✅ Security audit has been performed
# ✅ Penetration testing is complete

